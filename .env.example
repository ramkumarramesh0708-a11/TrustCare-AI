# TrustCare AI - Environment Configuration
PROJECT_NAME="TrustCare AI"
ENVIRONMENT="development"
SECRET_KEY="trustcare-super-secret-development-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for quick execution; set to PostgreSQL for production
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/trustcare_ai"
DATABASE_URL="sqlite:///./trustcare_ai.db"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Simulated Notifications
ENABLE_SIMULATED_NOTIFICATIONS=true
